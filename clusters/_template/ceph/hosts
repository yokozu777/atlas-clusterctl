all:
  children:
    ceph:
      children:
        ceph_nodes:
          hosts:
            192.168.1.181:
              hostname: ceph-01.example.com
              ceph_osd_devices:
                - /dev/disk/by-id/wwn-0x5000c500c35c5900
              provision:
                vmid: "5900"
                sockets: 1
                cores: 4
                memory: 8192
                numa: false
                clone: ubuntu-base
                disks:
                  - size: "50"
                    slot: 0
                    storage: local-zfs
                  - size: "100"
                    slot: 1
                    storage: local-zfs
                    wwn: "0x5000c500c35c5900"
                    serial: drive5900
            192.168.1.182:
              hostname: ceph-02.example.com
              ceph_osd_devices:
                - /dev/disk/by-id/wwn-0x5000c500c35c5901
