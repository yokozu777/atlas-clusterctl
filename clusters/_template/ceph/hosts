                vmid: "5901"
                sockets: 1
                cores: 4
                memory: 8192
                numa: false
                clone: oracle-base
                disks:
                  - size: "50"
                    slot: 0
                    storage: local-zfs
                  - size: "100"
                    slot: 1
                    storage: local-zfs
                    wwn: "0x5000c500c35c5901"
                    serial: drive5901
            192.168.1.183:
              hostname: ceph-03.example.com
              ceph_osd_devices:
                - /dev/disk/by-id/wwn-0x5000c500c35c5902
